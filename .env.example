# Database connection string (PostgreSQL)
# For Vercel / Neon / Supabase: postgresql://username:password@hostname:5432/dbname?sslmode=require
# For local development with unix socket: postgresql://postgres@localhost:5433/quizdb?host=/home/saddam/Documents/Project/Quiz/.pgdata
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# Authentication secret for signing admin JWT sessions (min 32 random characters)
AUTH_SECRET="change-this-to-a-very-long-and-secure-random-secret-key-32-chars-min"

# Initial admin credentials for database seeding (scripts/seed.mjs)
ADMIN_EMAIL="admin@quizapp.com"
ADMIN_PASSWORD="Admin@QuizMaster2026!"

# Application URL (optional, for metadata/links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
